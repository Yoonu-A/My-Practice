
<%- include('Partials/header') %>

    <h1>Student List</h1>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Age</th>
                <th>Course</th>
                <th>Status</th>
            
            </tr>
        </thead>

        <tbody>
                <% students.forEach((student) => { %>
        <tr>
            <td><%= student.id %></td>
            <td><%= student.name %></td>
            <td><%= student.age %></td>
            <td><%= student.course %></td>

            <td>
                <% if (student.age >= 18) { %>
                    Adult
                <% } else { %>
                    Minor
                <% } %>
            </td>
        </tr>
    <% }); %>
</tbody>
    </table>

    
<%- include('Partials/footer') %>