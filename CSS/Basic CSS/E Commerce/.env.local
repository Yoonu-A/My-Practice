# NEXORA STORE - Environment Configuration
# Copy this file to .env.local for local development

# Security & Authentication
JWT_SECRET=nexora_super_secret_jwt_key_2026_sri_lanka_secure_hash
ADMIN_EMAIL=admin@nexorastore.lk
ADMIN_PASSWORD=Admin@Nexora2026!

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sri Lanka Payment Gateway (PayHere / Card Integration Structure)
# Replace with your actual merchant credentials from https://www.payhere.lk
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=1220000_DEMO_MERCHANT
PAYHERE_SECRET=demo_merchant_secret_key_sri_lanka
PAYHERE_MODE=sandbox

# Store Details
NEXT_PUBLIC_STORE_NAME="NEXORA STORE"
NEXT_PUBLIC_STORE_PHONE="+94 11 234 5678"
NEXT_PUBLIC_STORE_EMAIL="support@nexorastore.lk"
NEXT_PUBLIC_STORE_ADDRESS="No. 45, Galle Road, Colombo 03, Sri Lanka"
